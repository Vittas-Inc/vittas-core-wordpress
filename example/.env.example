# Copy to .env and fill in, then run:  docker compose run --rm seed

# Public URL of the demo site.
#
# Leave as localhost for a first look. To receive webhooks, start the tunnel
# (docker compose --profile tunnel up -d tunnel), copy the trycloudflare.com URL
# out of `docker compose logs tunnel`, set it here, and re-run the seed step so
# WordPress rewrites its home/siteurl to match.
SITE_URL=http://localhost:8080
WP_PORT=8080

ADMIN_USER=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# From the Vittas dashboard → Developers → API keys (test mode).
# Only the secret key is needed: WordPress creates each session server-side and
# the browser only ever sees the session-scoped client secret it returns.
VITTAS_TEST_SECRET_KEY=sk_test_

# From Vittas dashboard → Developers → Webhooks, after registering
# $SITE_URL/wp-json/vittas/v1/webhook as the endpoint.
VITTAS_TEST_WEBHOOK_SECRET=

# Only needed when pointing at a backend other than the default sandbox.
VITTAS_API_BASE=https://dev-api.core.vittasinternational.com
VITTAS_WIDGET_SRC=
