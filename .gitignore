# Local environment — never commit real API keys or webhook secrets.
.env
example/.env

*.log
.DS_Store
Thumbs.db

# Build output of `bin/build-zip.sh`.
build/
*.zip

# NOTE: no blanket `vendor/` rule here on purpose. This is a plain PHP plugin
# with no install step on the merchant's server, so lib/plugin-update-checker
# (including the vendor/ directory it ships) must be committed — WordPress
# unzips the release and runs it as-is.
